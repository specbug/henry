<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Service identifier -->
    <key>Label</key>
    <string>com.henry.daemon</string>

    <!-- Program to execute -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/henry</string>
        <string>run</string>
        <string>--headless</string>
    </array>

    <!-- Start at login/boot -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart if crashes -->
    <key>KeepAlive</key>
    <dict>
        <!-- Only keep alive if exits with non-zero (crash) -->
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Throttle restarts: wait 10 seconds between restart attempts -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Working directory -->
    <key>WorkingDirectory</key>
    <string>/usr/local/bin</string>

    <!-- Environment variables -->
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Ensure 1Password CLI is in PATH -->
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <!-- Home directory for config resolution -->
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>__HOME__/.henry/logs/launchd-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.henry/logs/launchd-stderr.log</string>

    <!-- Resource limits -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>10240</integer>
    </dict>

    <!-- Process priority (0 = normal, negative = higher priority) -->
    <key>Nice</key>
    <integer>0</integer>

    <!-- Wait for network before starting -->
    <key>NetworkState</key>
    <true/>
</dict>
</plist>
